<Window x:Class="memoNOW.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ショートカット設定 - memoNOW"
        Width="430"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="グローバルショートカット"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#17181A" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,14"
                   Text="下の欄をクリックして、使いたいキーの組み合わせを実際に押してください。"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#696D75" />

        <Button x:Name="HotkeyCaptureButton"
                Grid.Row="2"
                Height="48"
                Padding="12,8"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                GotKeyboardFocus="HotkeyCaptureButton_GotKeyboardFocus"
                PreviewKeyDown="HotkeyCaptureButton_PreviewKeyDown" />

        <TextBlock x:Name="HintText"
                   Grid.Row="3"
                   Margin="2,10,2,0"
                   Text="Ctrl / Alt / Shift / Win のいずれかを含む組み合わせを指定してください。"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#7A7F88" />

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="86"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Content="キャンセル"
                    IsCancel="True" />
            <Button Width="86"
                    Padding="10,6"
                    Content="保存"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
