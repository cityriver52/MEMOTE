<Window x:Class="memoNOW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="memoNOW"
        Width="440"
        Height="560"
        MinWidth="360"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#DDF3FF"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="WaterBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F1FBFF" Offset="0" />
            <GradientStop Color="#DDF4FF" Offset="0.48" />
            <GradientStop Color="#C5E8F8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BubbleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FFFFFF" Offset="0" />
            <GradientStop Color="#EAF8FE" Offset="0.55" />
            <GradientStop Color="#DDEFF8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BubbleButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FAFFFFFF" Offset="0" />
            <GradientStop Color="#DCEFF8" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="BubbleActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="{StaticResource BubbleButtonBrush}" />
            <Setter Property="BorderBrush" Value="#9ED4EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#315E70" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#6DB7D4"
                                                  BlurRadius="10"
                                                  ShadowDepth="1"
                                                  Opacity="0.12" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#70C8EA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#54C9F4" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Shell" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4BC6F6"
                                                          BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.42" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftUtilityButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="#68FFFFFF" />
            <Setter Property="BorderBrush" Value="#86C9E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#476A78" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#B8FFFFFF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#5CBEE2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#48BFEA" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWater">
        <Grid.Background>
            <StaticResource ResourceKey="WaterBackgroundBrush" />
        </Grid.Background>

        <!-- Abstract water-light layer. It should feel underwater without becoming an illustration. -->
        <Canvas x:Name="AmbientLayer"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Ellipse Width="250" Height="250" Canvas.Left="-80" Canvas.Top="-92" Opacity="0.18" Fill="#FFFFFFFF">
                <Ellipse.Effect>
                    <BlurEffect Radius="38" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="190" Height="190" Canvas.Left="292" Canvas.Top="82" Opacity="0.13" Fill="#FFFFFFFF">
                <Ellipse.Effect>
                    <BlurEffect Radius="44" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="220" Height="160" Canvas.Left="-54" Canvas.Top="430" Opacity="0.10" Fill="#7DD9F5">
                <Ellipse.Effect>
                    <BlurEffect Radius="50" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="18" Height="18" Canvas.Left="45" Canvas.Top="390" Opacity="0.26" Fill="#ECFFFFFF" Stroke="#A5DDF1" StrokeThickness="1" />
            <Ellipse Width="10" Height="10" Canvas.Left="92" Canvas.Top="330" Opacity="0.23" Fill="#ECFFFFFF" Stroke="#A5DDF1" StrokeThickness="1" />
            <Ellipse Width="24" Height="24" Canvas.Left="354" Canvas.Top="420" Opacity="0.20" Fill="#ECFFFFFF" Stroke="#A5DDF1" StrokeThickness="1" />
            <Ellipse Width="12" Height="12" Canvas.Left="326" Canvas.Top="285" Opacity="0.23" Fill="#ECFFFFFF" Stroke="#A5DDF1" StrokeThickness="1" />
            <Ellipse Width="8" Height="8" Canvas.Left="384" Canvas.Top="205" Opacity="0.18" Fill="#FFFFFFFF" Stroke="#A5DDF1" StrokeThickness="1" />
        </Canvas>

        <Grid Margin="18,16,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="memoNOW"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#17313D" />
                        <Ellipse Width="9" Height="9"
                                 Margin="7,3,0,0"
                                 VerticalAlignment="Top"
                                 Fill="#A8ECFF"
                                 Stroke="#68C9E9"
                                 StrokeThickness="1" />
                    </StackPanel>
                    <TextBlock Text="いま頭に浮いていることだけ。"
                               Margin="1,3,0,0"
                               FontSize="12"
                               Foreground="#5C7884" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Ellipse Width="5" Height="5" Margin="0,0,13,3" HorizontalAlignment="Right" Fill="#9FE8FC" Opacity="0.9" />
                    <Ellipse Width="10" Height="10" Margin="0,0,3,0" HorizontalAlignment="Right" Fill="#D8F7FF" Stroke="#83D7EF" StrokeThickness="1" />
                </StackPanel>
            </Grid>

            <Border x:Name="InputShell"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    Padding="14,9"
                    CornerRadius="22"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#C8FFFFFF" />
                        <Setter Property="BorderBrush" Value="#A6D8EA" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#64B8D6" BlurRadius="18" ShadowDepth="3" Opacity="0.13" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="#EBFFFFFF" />
                                <Setter Property="BorderBrush" Value="#62C9EE" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#45BFEA" BlurRadius="22" ShadowDepth="0" Opacity="0.28" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <TextBlock Text="いま浮かんだことを追加…"
                               Margin="1,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#7E9BA7"
                               FontSize="15"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=MemoInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox x:Name="MemoInput"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#17313D"
                             CaretBrush="#319BC3"
                             FontSize="15"
                             MaxLength="240"
                             ToolTip="Enterで泡を追加"
                             KeyDown="MemoInput_KeyDown" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="-2,0,-2,0"
                          Padding="2,3,2,7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Memos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="BubbleHost"
                                  Tag="{Binding Id}"
                                  Margin="0,0,0,11"
                                  RenderTransformOrigin="0.5,0.5"
                                  Loaded="BubbleHost_Loaded">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>

                                <Border x:Name="BubbleVisual"
                                        Tag="{Binding Id}"
                                        Padding="15,12,12,12"
                                        CornerRadius="28"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
                                            <Setter Property="BorderBrush" Value="#9FD3E7" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#5CAFCF"
                                                                      BlurRadius="22"
                                                                      ShadowDepth="4"
                                                                      Opacity="0.16" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4CC7F2" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#43C4F4"
                                                                              BlurRadius="24"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.38" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <!-- Soft membrane highlight -->
                                        <Border Height="20"
                                                Margin="8,-4,80,0"
                                                VerticalAlignment="Top"
                                                CornerRadius="10"
                                                Opacity="0.52"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Text}"
                                                       Margin="2,2,12,2"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Medium"
                                                       Foreground="#203E4A"
                                                       TextWrapping="Wrap" />

                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="✓"
                                                    Tag="{Binding Id}"
                                                    ToolTip="完了（Delete / Enter）"
                                                    Style="{StaticResource BubbleActionButtonStyle}"
                                                    Click="CompleteMemo_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3"
                  Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="#64808C"
                           TextWrapping="Wrap" />

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="ショートカット設定"
                        Style="{StaticResource SoftUtilityButtonStyle}"
                        Click="ShortcutSettings_Click" />
            </Grid>
        </Grid>

        <!-- Runtime-created birth/pop particles live here. -->
        <Canvas x:Name="ParticleLayer"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Panel.ZIndex="50" />
    </Grid>
</Window>
